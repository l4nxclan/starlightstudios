# Get a free token at https://huggingface.co/settings/tokens (read access is enough)
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any random string you make up — this stops strangers from spamming your endpoint.
# You'll put this same value in BotGhost's webhook headers as x-shared-secret.
SHARED_SECRET=change-me-to-something-random

# 0.0 - 1.0. Higher = stricter (fewer false positives, may miss some duplicates).
# 0.85 is a reasonable starting point.
SIMILARITY_THRESHOLD=0.85

# Render sets PORT automatically — you usually don't need to set this yourself.
PORT=3000
